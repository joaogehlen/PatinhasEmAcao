# Copie para .env e preencha com os valores do seu projeto.
# Painel do Supabase > Project Settings > API
#
# As duas chaves abaixo são públicas por design: o app as embute no bundle e
# quem protege os dados é a RLS, não o segredo da chave.
#
# NUNCA coloque aqui a service_role key nem a senha do banco. A service_role
# ignora toda a RLS — no app, ela equivale a dar acesso total a qualquer pessoa
# que baixe o APK.

EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sua-publishable-ou-anon-key

