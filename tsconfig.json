{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": ["jest"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  // supabase/functions roda em Deno, com outro runtime e outras globais.
  // O deploy é feito pelo CLI do Supabase, que faz a própria checagem.
  "exclude": ["node_modules", "supabase"]
}
